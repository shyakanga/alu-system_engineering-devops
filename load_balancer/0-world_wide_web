#!/usr/bin/env bash
#Displaying IP addresses of a domain

if [[ "$#" -lt 1 ]]
then
    exit 1
fi


domain="$1"
subdomains=("www" "lb-01" "web-01" "web-02")

if [[ "$#" -lt 2 ]]
then
    for((i=0;i<=3;i++)); do
	echo "The subdomain ${subdomains[i]} is a A record and points to $(dig +short ${subdomains[i]}.${domain})"
    done
else
    subdomain="$2"
    echo "The subdomain ${subdomain} is a A record and points to $(dig +short ${subdomain}.${domain})"
fi
